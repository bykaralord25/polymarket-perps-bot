TRADING_MODE=paper
MARKET_SOURCE=polymarket
SYMBOL=BTC
STARTING_BALANCE=10000
RISK_PER_TRADE=0.01
MAX_LEVERAGE=2
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.02
DAILY_LOSS_LIMIT_PCT=0.03
TICK_INTERVAL_MS=1000

# v0.9 includes safety-gated live infrastructure, but the default main app remains paper execution.
# Never commit a private key, seed phrase, API secret, delegated credential, or real .env file.
# Live-session variables are intentionally not enabled by the default launcher.
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_DEPOSIT_WALLET=
